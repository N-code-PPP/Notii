rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidNote(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 20000 &&
             (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128)) &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40)) &&
             data.colorHex is string && data.colorHex.size() <= 20 &&
             data.isPinned is bool &&
             data.isLocked is bool &&
             data.passwordHash is string && data.passwordHash.size() <= 256 &&
             data.encryptedPayload is string && data.encryptedPayload.size() <= 30000 &&
             data.reminderEpochMillis is int && data.reminderEpochMillis >= 0 &&
             data.reminderLabel is string && data.reminderLabel.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCategory(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.colorHex is string && data.colorHex.size() >= 1 && data.colorHex.size() <= 20 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFolder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.parentFolderId is string && data.parentFolderId.size() <= 128 &&
             data.colorHex is string && data.colorHex.size() >= 1 && data.colorHex.size() <= 20 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Per-User Notes Collection
    match /users/{userId}/notes/{noteId} {
      allow get: if isOwner(userId) &&
                    isValidId(userId) &&
                    isValidId(noteId) &&
                    existing().userId == request.auth.uid;

      allow list: if isOwner(userId) &&
                     existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(noteId) &&
                       isValidNote(incoming()) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'content', 'category', 'tags', 'colorHex',
                         'isPinned', 'isLocked', 'passwordHash', 'encryptedPayload',
                         'reminderEpochMillis', 'reminderLabel', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'content', 'folderId', 'category', 'tags', 'colorHex',
                         'isPinned', 'isLocked', 'passwordHash', 'encryptedPayload',
                         'reminderEpochMillis', 'reminderLabel', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(noteId) &&
                       isValidNote(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'content', 'folderId', 'category', 'tags', 'colorHex',
                         'isPinned', 'isLocked', 'passwordHash', 'encryptedPayload',
                         'reminderEpochMillis', 'reminderLabel', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(noteId) &&
                       existing().userId == request.auth.uid;
    }

    // 5. Per-User Categories Collection
    match /users/{userId}/categories/{categoryId} {
      allow get: if isOwner(userId) &&
                    isValidId(userId) &&
                    isValidId(categoryId) &&
                    existing().userId == request.auth.uid;

      allow list: if isOwner(userId) &&
                     existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(categoryId) &&
                       isValidCategory(incoming()) &&
                       incoming().keys().hasAll(['userId', 'name', 'colorHex', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'colorHex', 'createdAt']);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(categoryId) &&
                       isValidCategory(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'colorHex']);

      allow delete: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(categoryId) &&
                       existing().userId == request.auth.uid;
    }

    // 6. Per-User Folders Collection
    match /users/{userId}/folders/{folderId} {
      allow get: if isOwner(userId) &&
                    isValidId(userId) &&
                    isValidId(folderId) &&
                    existing().userId == request.auth.uid;

      allow list: if isOwner(userId) &&
                     existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(folderId) &&
                       isValidFolder(incoming()) &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'parentFolderId', 'colorHex', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'parentFolderId', 'colorHex', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(folderId) &&
                       isValidFolder(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'parentFolderId', 'colorHex', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(folderId) &&
                       existing().userId == request.auth.uid;
    }
  }
}
