<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_camera_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/quick_camera_widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_button"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_camera_shot_btn"
        android:textColor="#1E1300"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quick_camera_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_quick_camera_title"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quick_camera_widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_quick_camera_subtitle"
        android:textColor="#94A3B8"
        android:textSize="10sp" />
</LinearLayout>
